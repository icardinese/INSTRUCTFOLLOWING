# Deterministic caches -- safe to delete anytime, regenerates identically from the same code+data.
# Separate from results/, which holds outputs (e.g. const_steer_directions.pt) that are NOT
# guaranteed to regenerate identically (LLM-judged sweeps, etc.) -- losing those is a real loss.
cache/

# Precious outputs -- gitignored here too since they're Drive-backed, not git-backed (see
# infra/setup_colab.sh) -- committing checkpoint .pt files directly bloats the repo.
# ** (not *) is required here: results/ is per-task now (results/caveman/*.pt), and a bare
# "results/*.pt" glob does NOT match across that extra directory level -- confirmed with
# `git check-ignore` actually failing to catch a nested test file before this fix.
results/**/*.pt
results/**/*.zip
results/**/*.png
results/**/*.jsonl
results/**/*.json
!results/**/.gitkeep

# Auto-generated from docstrings via infra/build_docs.sh -- regenerate on demand, don't commit.
docs_html/

__pycache__/
*.pyc
.pytest_cache/
openai.key
openai.key
openai.key*

results
cache
*.old_local/
*.pt
apply_*.py
consolidate.py
